<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <title>BrainIt</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/256/882/882998.png" type="image/png">
    <link rel = "stylesheet" href = "styles.css">
    
</head>
<body>

    <div class="topnav">
        <div class="topnav-left">
            <a href="/" class = "custom-style"><div class="topnav-child">Home</div></a>
            <a href="/" class = "custom-style"><div class="topnav-child">Genre</div></a>
            <div class="topnav-child"><div class = "ld">Leaderboard</div></div>
        </div>
        <div class="topnav-right">
            <img src="https://pngimg.com/d/coin_PNG36871.png" class="topnav-coins">
            <span id ="coin-value">0</span>
            <div onclick = "loginorsignin()"><img class="topnav-profile" src="https://static.vecteezy.com/system/resources/previews/019/879/186/original/user-icon-on-transparent-background-free-png.png"></div>
        </div>
    </div>


    <div class="genre">
        <div class="genre-container">
            <h1 class = "genreselect">Select a genre</h1>
            <button id="close" onclick = "close_genre()">X</button>
            <div class = "genre-buttons">
                <button class="1" onclick = "quiz_generate(9)">General Knowledge</button>
                <button class="2" onclick = "quiz_generate(15)">Video Games</button>
                <button class="3" onclick = "quiz_generate(18)">CSE</button>
            </div>
        </div>
    </div>
    

    <div class="quiz-container">
        <div class="quiz">
            <div class = "question">
                <p class="question"></p>
            </div>
            <div class="quiz-buttons">
                <button class="q"></button>
                <button class="q"></button>
                <button class="q"></button>
                <button class="q"></button>
            </div>
        </div>
    </div>
    
    <div class = "table-container">
        <table>
          <thead>
            <tr>
                <th>Rank</th>
                <th>Name</th>
                <th>Country</th>
                <th>Score</th>
            </tr>
        </thead>
            <tbody>

            </tbody>
        </table>
    </div>

    

</body>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="script.js"></script>

</html>
