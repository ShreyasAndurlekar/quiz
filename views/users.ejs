<!DOCTYPE html>
<html>
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <title>BrainIt</title>

    <link rel = "stylesheet" href = "styles.css">
    
</head>
<body>

    <div class="topnav">
        <div class="topnav-left">
            <a href="/" class = "custom-style"><div class="topnav-child">Home</div></a>
            <a href="/" class = "custom-style"><div class="topnav-child">Genre</div></a>
            <div class="topnav-child"><div class = "ld">Leaderboard</div></div>
        </div>
        <div class="topnav-right">
            <div class="topnav-coins"><img src="https://pngimg.com/d/coin_PNG36871.png" width="40" height="40"></div>
            <span id ="coin-value">0</span>
            <div class="topnav-profile" onclick = "loginorsignin()"><img src="https://static.vecteezy.com/system/resources/previews/019/879/186/original/user-icon-on-transparent-background-free-png.png" width="80" height="50"></div>
        </div>
    </div>

    <div class = "uff-container">
        <div class = "userfillform">
            <form class = "fillform" action = "/signup" method = "POST">
                <h class = "that">Create a new account</h>
                <label for = "name">Username</label>
                <input type = "text" name="username">
                <label for = "password">Setup a password</label>
                <input type = "password" name = "password">
                <label for = "country">Country</label>
                <input type = "text" name = "country">
                <input type = "submit" value = "Submit">
            </form>
            <% if (message !== "undefined") { %>
                <p><%= message %></p>
                <% } %>
        </div>
    </div>
    
    <div class = "login-container">
        <div class = "login">
            <form class = "login" action = "/login" method = "POST">
                <h class = "thatx">Sign in to your account</h>
                <label for = "name">Username</label>
                <input type = "text" name="username" id = "lusername">
                <label for = "password">Enter password</label>
                <input type = "password" name = "password" id = "lpassword">
                <div class = "buttons">
                    <input type = "submit" value = "Submit" onclick = "loginredirect()">
                </div>
            </form>
            <button class = "signup" onclick = "dosignup()">Sign Up</button>        <!-- Button outside form otherwise it gets /login gets triggered-->
        </div>
        <% if (message !== "undefined") { %>
            <p><%= message %></p>
            <% } %>
    </div>

</body>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src = "forms.js"></script>
<script src="script.js"></script>


</html>